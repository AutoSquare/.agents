      "gstack-ios-sync",
      "gstack-land-and-deploy",
      "gstack-learn",
      "gstack-make-pdf",
      "gstack-open-gstack-browser",
      "gstack-pair-agent",
      "gstack-plan-devex-review",
      "gstack-plan-tune",
      "gstack-qa",
      "gstack-qa-only",
      "gstack-retro",
      "gstack-scrape",
      "gstack-setup-browser-cookies",
      "gstack-setup-deploy",
      "gstack-skillify",
      "gstack-unfreeze"
    ],
    "excludedSkills": {
      "gstack": "router would expose omitted duplicate entries",
      "gstack-autoplan": "brainstorming + writing-plans + review skills",
      "gstack-careful": "global destructive-action guardrails",
      "gstack-claude": "host-specific wrapper for another runtime",
      "gstack-context-restore": "handoff",
      "gstack-context-save": "handoff",
      "gstack-design-consultation": "brand + design-system + ui-ux-pro-max",
      "gstack-design-shotgun": "prototype + UI design skills",
      "gstack-guard": "global guardrails + retained freeze skill",
      "gstack-investigate": "diagnose + systematic-debugging",
      "gstack-landing-report": "depends on the omitted ship workflow",
      "gstack-office-hours": "brainstorming + grill-me",
      "gstack-plan-ceo-review": "brainstorming + grill-me",
      "gstack-plan-design-review": "ui-ux-pro-max + design-system",
      "gstack-plan-eng-review": "writing-plans + improve-codebase-architecture",
      "gstack-review": "requesting-code-review",
      "gstack-setup-gbrain": "external global configuration is outside this portable package",
      "gstack-ship": "finishing-a-development-branch",
      "gstack-spec": "to-prd + to-issues",
      "gstack-sync-gbrain": "depends on omitted gbrain setup",
      "gstack-upgrade": "the portable package owns upgrades"
    }
  },
  "mcpServers": {
    "academic-research": {
      "source": "https://github.com/alisoroushmd/academic-research-mcp",
      "install": "git clone + python venv + pip install -r requirements.txt",
      "purpose": "multi-source academic search"
    },
    "zotero": {
      "source": "https://github.com/Xpropel/zotero-mcp",
      "install": "git clone + npm install + npm run build",
      "purpose": "local Zotero library access"
    },
    "deck-builder": {
      "source": "https://github.com/toontube/deck-builder",
      "install": "git clone + npm install + npm run build",
      "purpose": "structured editable PPTX generation"
    },
    "ppt-markdown": {
      "source": "https://www.npmjs.com/package/@botrun/mcp-ppt-generator",
      "install": "npx -y @botrun/mcp-ppt-generator",
      "purpose": "Markdown to PPTX"
    },
    "campus-net-mcp": {
      "source": "bundled: .agents/mcp-servers-src/campus-net-mcp",
      "install": ".agents/scripts/setup-cursor-agents.ps1 或 .agents/scripts/setup-codex-agents.ps1",
      "purpose": "通用学校 Profile：馆藏探测、会话与全文下载链路"
    }
  },
