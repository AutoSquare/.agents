{
  "name": "portable-agents",
  "description": "可迁移 Agent Skills + Rules + MCP 包（文献检索、Zotero、PPT、ppt-maker、campus-net、UI/UX 设计技能、Superpowers、去重后的 gstack、Karpathy 编码准则等）；安装入口包含 Cursor、Codex、Antigravity 与 QoderCN 脚本。",
  "skillsRoot": "skills",
  "rulesRoot": "rules",
  "rulesCursor": "rules/cursor",
  "rulesUniversal": "rules/universal/AGENTS.md",
  "skillSources": {
    "superpowers": {
      "source": "https://github.com/obra/superpowers",
      "version": "6.1.1",
      "license": "MIT",
      "workspaceSourceDir": "../superpowers/skills",
      "copyMode": "verbatim",
      "licenseFile": "licenses/superpowers-LICENSE.txt"
    },
    "gstack": {
      "source": "https://github.com/garrytan/gstack",
      "version": "1.60.1.0",
      "license": "MIT",
      "workspaceSourceDir": "../gstack",
      "copyMode": "deduplicated_host_generated",
      "licenseFile": "licenses/gstack-LICENSE.txt"
    }
  },
  "gstackIntegration": {
    "supportedHosts": [
      "codex",
      "cursor"
    ],
    "hostSkillsRoot": "host-skills",
    "runtimeSourceDir": "runtime/gstack",
    "selectedSkills": [
      "gstack-benchmark",
      "gstack-benchmark-models",
      "gstack-browse",
      "gstack-canary",
      "gstack-cso",
      "gstack-design-html",
